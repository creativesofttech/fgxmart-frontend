# Browser-accessible Laravel API. No trailing slash.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Optional internal API URL used only by the Nuxt server for admin requests.
# In production, set this or NUXT_PUBLIC_API_BASE to the deployed Laravel API.
NUXT_API_BASE=http://localhost:8000/api/v1

# Production values:
# NUXT_PUBLIC_API_BASE=https://api.fgxmart.com/api/v1
# NUXT_API_BASE=https://api.fgxmart.com/api/v1

# Production requires HTTPS; admin cookies are Secure in production builds.
GTAG_ID=
